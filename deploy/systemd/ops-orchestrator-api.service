[Unit]
Description=Ops Orchestrator API
After=network-online.target postgresql.service ops-orchestrator-redis.service
Wants=network-online.target

[Service]
Type=simple
User=ops-orchestrator
Group=ops-orchestrator
WorkingDirectory=/opt/ops-orchestrator/repos/project-registry
EnvironmentFile=/etc/ops-orchestrator/ops.env
Environment=HOME=/opt/ops-orchestrator
Environment=PATH=/opt/ops-orchestrator/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=OPS_BIND_HOST=127.0.0.1
Environment=OPS_BIND_PORT=8000
ExecStart=/opt/ops-orchestrator/venv/bin/uvicorn app.main:app --host ${OPS_BIND_HOST} --port ${OPS_BIND_PORT}
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
